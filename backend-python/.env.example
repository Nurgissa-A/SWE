ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://biletflow:replace-with-local-password@localhost:5432/biletflow
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
JWT_PRIVATE_KEY_FILE=../.secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=../.secrets/jwt-public.pem
JWT_ISSUER=biletflow-identity
JWT_AUDIENCE=biletflow-api
JWT_KEY_ID=biletflow-local-1
ACCESS_TOKEN_MINUTES=15
VERIFICATION_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=15
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=noreply@biletflow.example
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","python"]

NOTIFICATION_KEY_FILE=../.secrets/notification.key
SERVICE_TOKEN_FILE=../.secrets/service-token
BUSINESS_URL=http://localhost:8080
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_EMAIL=10
AUTH_RATE_LIMIT_PER_IP=60
NOTIFICATION_EAGER_DELIVERY=false
