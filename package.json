{
  "name": "biletflow-api-tools",
  "private": true,
  "scripts": {
    "api:lint": "spectral lint --fail-severity warn docs/openapi.yaml",
    "api:mock": "prism mock -h 127.0.0.1 docs/openapi.yaml",
    "api:types": "openapi-typescript docs/openapi.yaml -o frontend/src/lib/api-types.ts"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/spectral-cli": "6.17.0",
    "openapi-typescript": "7.13.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "uuid": "11.1.1"
  }
}
